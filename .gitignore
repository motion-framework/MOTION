# Local configuration and secrets
.env
.env.*
!.env.example
.envrc
.direnv/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.cache/
.hypothesis/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# IDE and operating-system state
.idea/
.vscode/
.vs/
*.iml
.DS_Store
Thumbs.db

# Temporary files and logs
tmp/
temp/
*.log
*.tmp
*.swp
*~

# Application runtime state and generated output.
var/*
!var/.gitkeep
outputs/*
!outputs/.gitkeep

# Generated data. Curated reference inputs remain versionable.
data/*

# Generated artifacts. Curated reference artifacts remain versionable.
artifacts/*

# Map-repair backups
*.prepatch.bak
*.preclamp.bak

# Curated reference material always remains eligible for version control,
# even when a nested filename matches a generated-artifact pattern above.
!data/reference/
!data/reference/**
!artifacts/reference/
!artifacts/reference/**
