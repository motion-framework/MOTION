# Copy this file to .env and set local values there. Never commit credentials.
#
# Active-map state (bounds, selected map, generated paths, device registry and
# road-selection filters) is stored as JSON in var/runtime/active_map.json, not here.
# Set this in the process environment when invoking an installed wheel outside
# its source checkout; it determines where `.env`, data and artifacts live.
TRAFFIC_MIRROR_PROJECT_ROOT=

# CARLA is installed separately and is not a PyPI dependency of this project.
CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TRAFFIC_MANAGER_PORT=8000
CARLA_CLIENT_TIMEOUT_SECONDS=120
CARLA_EXECUTABLE_PATH=

# Keep credentials empty in this example; set them only in your local .env.
HERE_API_KEY=
HERE_FLOW_URL=https://data.traffic.hereapi.com/v7/flow
HERE_INCIDENTS_URL=https://data.traffic.hereapi.com/v7/incidents
HERE_REQUEST_TIMEOUT_SECONDS=10
HERE_ARCHIVE_MODE=off

# Use a monitored contact address in your local .env when downloading OSM data.
OSM_DOWNLOADER_CONTACT_EMAIL=
OSM_OVERPASS_ENDPOINTS=https://overpass-api.de/api/map,https://overpass.kumi.systems/api/map,https://overpass.private.coffee/api/map
OSM_REQUEST_TIMEOUT_SECONDS=180

MIRROR_UPDATE_INTERVAL_SECONDS=60
MIRROR_ROAD_FILTER=
MIRROR_GEO_FILTER=false
MIRROR_ANCHOR_FC=
